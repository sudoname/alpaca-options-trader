ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_PAPER=true

# ---------------------------------------------------------------------------
# Telegram trading bot (telegram_bot.py)
# ---------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN       : bot token from @BotFather
# TELEGRAM_CHAT_ID         : owner chat ID (always authorized)
# TELEGRAM_ALLOWED_CHAT_IDS: comma-separated list of additional chat IDs
#                            allowed to use the bot (e.g. to authorize other
#                            people). The owner TELEGRAM_CHAT_ID is always
#                            included. If both are empty, the bot is open to all.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_ALLOWED_CHAT_IDS=

# ---------------------------------------------------------------------------
# Reinforcement Learning layer (tabular Q-learning, shadow/advisory)
# ---------------------------------------------------------------------------
# RL_ENABLED   : turn the advisory layer on/off (true|false)
# RL_MODE      : shadow = recommend + learn only (does NOT change trades).
#                gate/control are reserved for future active use.
# RL_ALPHA     : learning rate
# RL_GAMMA     : discount factor (cross-day PDT coupling)
# RL_EPSILON   : exploration rate (decays toward RL_EPSILON_MIN)
RL_ENABLED=true
RL_MODE=shadow
RL_ALPHA=0.10
RL_GAMMA=0.50
RL_EPSILON=0.20
RL_EPSILON_DECAY=0.995
RL_EPSILON_MIN=0.02

# Conservative veto-only gate (currently used by backtest_rl_gate.py only).
# The gate can turn a rule-chosen CALL/PUT into a SKIP, but never flips
# direction and never mutates the Q-table. A veto fires only when a state has
# enough history AND a materially negative learned value AND enough confidence.
# RL_GATE_MIN_VISITS    : min (state,action) visits before a veto is allowed
# RL_GATE_MAX_Q         : veto only when learned Q is at/below this (negative)
# RL_GATE_MIN_CONFIDENCE: confidence = min(1, visits/min_visits) required to veto
RL_GATE_MIN_VISITS=8
RL_GATE_MAX_Q=-0.10
RL_GATE_MIN_CONFIDENCE=0.75

# ---------------------------------------------------------------------------
# Market Fear & Greed sentiment module
# ---------------------------------------------------------------------------
# SENTIMENT_ENABLED        : master on/off switch for the sentiment filter
# SENTIMENT_CACHE_MINUTES  : how long to reuse a computed score before refresh
# SENTIMENT_USE_CNN        : fetch CNN's unofficial Fear & Greed index
# SENTIMENT_USE_CUSTOM     : compute our own score from market data (PRIMARY)
# SENTIMENT_PRIMARY_SOURCE : which score drives trade decisions (custom|cnn)
# SENTIMENT_MIN_COMPONENTS : min available components for a valid custom score
# SENTIMENT_CNN_URL        : (optional) override CNN endpoint
# SENTIMENT_CNN_TIMEOUT    : (optional) CNN request timeout, seconds
# SENTIMENT_HISTORY_DAYS   : (optional) days of daily history for the custom score
# SENTIMENT_MOMENTUM_WINDOW: (optional) SPY moving-average window (trading days)
# SENTIMENT_CACHE_FILE     : (optional) cache file path
SENTIMENT_ENABLED=true
SENTIMENT_CACHE_MINUTES=15
SENTIMENT_USE_CNN=true
SENTIMENT_USE_CUSTOM=true
SENTIMENT_PRIMARY_SOURCE=custom
SENTIMENT_MIN_COMPONENTS=3

# ---------------------------------------------------------------------------
# Stock screener (stock_screener.py) — Nasdaq Buy/Strong-Buy universe ranked
# with Alpaca price data (keeps the project's data source, no Yahoo Finance).
# ---------------------------------------------------------------------------
# NASDAQ_API_URL      : Nasdaq screener API URL (Buy/Strong-Buy universe)
# STOCK_MIN_PRICE     : skip stocks priced below this
# STOCK_MAX_PRICE     : skip stocks priced above this
# MAX_NUM_STOCKS      : max number of picks to return
# MOVED_DAYS          : lookback (trading days) for the movement/range metrics
# SCREEN_STRATEGY     : default ranking: moved | lowtomarket | lowtohigh
# SCREENER_ALPACA_FEED: Alpaca market-data feed for bars (iex|sip)
NASDAQ_API_URL=https://api.nasdaq.com/api/screener/stocks?tableonly=true&limit=100&marketcap=large|mid|small&recommendation=strong_buy|buy
STOCK_MIN_PRICE=20
STOCK_MAX_PRICE=100
MAX_NUM_STOCKS=20
MOVED_DAYS=5
SCREEN_STRATEGY=moved
SCREENER_ALPACA_FEED=iex

# ---------------------------------------------------------------------------
# Oracle web dashboard (oracle_dashboard.py) — read-only analytics UI.
# A separate Flask process from the bot/scheduler; GET-only report endpoints
# bound to localhost behind nginx (TLS via certbot + basic auth). Cannot trade.
# ---------------------------------------------------------------------------
# DASHBOARD_HOST            : bind address (keep 127.0.0.1; nginx is public face)
# DASHBOARD_PORT            : bind port behind the reverse proxy
# DASHBOARD_CACHE_TTL       : seconds to cache a report payload between hits
# DASHBOARD_BASIC_AUTH_USER : app-level basic-auth user (defense-in-depth;
# DASHBOARD_BASIC_AUTH_PASS : leave both blank for local dev — nginx is the
#                             primary auth in production)
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
DASHBOARD_CACHE_TTL=60
DASHBOARD_BASIC_AUTH_USER=
DASHBOARD_BASIC_AUTH_PASS=
# ---------------------------------------------------------------------------
# Oracle 2.1 signal-engine enrichment (all flags default OFF; each is
# fail-open; with ALL off the agent slate + probabilities are byte-identical
# to the prior release). Toggling only needs a .env edit + `systemctl restart
# alps-bot` — ConfigLoader is shell-env-first, no redeploy required.
# ---------------------------------------------------------------------------
# USE_MODE_AWARE_TREND       : derive trend/momentum horizon from ORACLE_MODE
#                              (intraday vs swing) instead of a fixed daily span
# USE_INTRADAY_FEATURES      : opening-range / gap / VWAP / 1-5m momentum feats
# USE_ORDERBOOK_IMBALANCE    : Robinhood price-book bid/ask imbalance signal
#                              (needs the RH_* keys + robin_stocks installed)
# USE_LEVEL_RECLAIM          : reclaim/loss of MA / prior-day H-L / VWAP signal
# USE_OPTIONS_FLOW           : call/put vol+OI skew, unusual volume, IV term
# USE_DEALER_GAMMA           : dealer gamma exposure (GEX) regime + flip point
# USE_ORACLE_PROB_RECORDER   : log every Oracle head (incl. no-trades) to the
#                              probability ledger for later calibration
# USE_EXPECTED_MOVE_COHERENCE: erode P(no-trade) when a large move is implied
#                              (fixes 99% no-trade next to a big expected move)
# USE_ORACLE_TRADE_GATE      : promote the Oracle head from shadow to a live
#                              VETO-ONLY gate (never sizes/flips; EV+risk still
#                              run after it). Keep OFF until calibrated.
# ORACLE_GATE_DRYRUN         : log "would-block" without acting (observe first)
USE_MODE_AWARE_TREND=false
USE_INTRADAY_FEATURES=false
USE_ORDERBOOK_IMBALANCE=false
USE_LEVEL_RECLAIM=false
USE_OPTIONS_FLOW=false
USE_DEALER_GAMMA=false
USE_ORACLE_PROB_RECORDER=false
USE_EXPECTED_MOVE_COHERENCE=false
USE_ORACLE_TRADE_GATE=false
ORACLE_GATE_DRYRUN=false

# Oracle 2.1 tunables (only consulted when the matching feature is enabled).
# ORACLE_EM_REF_PCT     : reference expected-move % at which the coherence fix
#                         removes half of the neutral mass (bigger = gentler)
# ORACLE_MAX_NO_TRADE   : gate vetoes when P(no-trade) >= this
# ORACLE_MIN_DIRECTIONAL: gate vetoes when max(P(call),P(put)) < this (0=off)
# ORACLE_MIN_AGREEMENT  : gate vetoes when the intended side's share of the
#                         directional mass < this (0=off)
# ALPACA_OPTIONS_FEED   : options snapshot feed for the flow/gamma chain fetch
#                         (indicative on the free tier; opra if entitled)
ORACLE_EM_REF_PCT=3.0
ORACLE_MAX_NO_TRADE=0.85
ORACLE_MIN_DIRECTIONAL=0.0
ORACLE_MIN_AGREEMENT=0.0
ALPACA_OPTIONS_FEED=indicative

# Robinhood price-book (only used when USE_ORDERBOOK_IMBALANCE=true). Session
# is pickled + TOTP-refreshed; the client fails open to no signal if login or
# the API misbehaves, so these can stay blank to disable the feature entirely.
# RH_USERNAME    : Robinhood login (email)
# RH_PASSWORD    : Robinhood password
# RH_MFA_SECRET  : TOTP secret for automated MFA (base32, from the RH app)
# RH_PICKLE_PATH : path to persist the authenticated session pickle
RH_USERNAME=
RH_PASSWORD=
RH_MFA_SECRET=
RH_PICKLE_PATH=

# ---------------------------------------------------------------------------
# Oracle 3.0 — Phase 1 upgrades (Lab / Temporal / Sim / Thesis / Executable EV).
# Every flag defaults OFF (executable-EV defaults to SHADOW). With all OFF the
# live decision path in smart_trader.py is byte-identical to the prior release;
# each new layer is fail-open and never bypasses the hard risk controls
# (risk_engine, PDT, buying power, duplicate/quote-freshness). Toggling only
# needs a .env edit + `systemctl restart alps-bot`.
# ---------------------------------------------------------------------------
# ENABLE_ORACLE_LAB            : documents intent to use the offline research
#                                harness (oracle/lab/*). The Lab is import-only
#                                and offline; this flag has NO live effect.
# ENABLE_TEMPORAL_INTEGRITY    : strict look-ahead protection (oracle/temporal).
#                                OFF = log-only fail-open; ON = raise in
#                                lab/sim. Live is unaffected (LiveMarketView
#                                uses as_of=now, so all data is trivially valid).
# ENABLE_EVENT_DRIVEN_SIMULATION: enable the unified backtest/sim driver. The
#                                live smart_trader path is untouched.
# ENABLE_ADVERSARIAL_THESIS    : compute bull/bear/no-trade theses + bounded
#                                skeptic review (oracle/thesis_debate). Shadow by
#                                default: stamps the adjusted P(no-trade) onto the
#                                record and logs it, but does NOT change the trade
#                                decision. Never flips direction / bypasses risk.
# ADVERSARIAL_THESIS_GATING    : promote the skeptic from shadow to gate-feeding.
#                                When ON (and ENABLE_ADVERSARIAL_THESIS ON) the
#                                review's adjusted probability replaces the raw
#                                Oracle-head prob fed to the Oracle trade gate, so
#                                a raised P(no-trade) can VETO an entry. Still
#                                veto-only (gate never sizes/flips); requires the
#                                Oracle trade gate to be enabled. OFF -> shadow /
#                                byte-identical.
# ENABLE_SEMANTIC_TRADE_MEMORY : record a postmortem reflection on close and
#                                attach prior lessons to the thesis notes as
#                                CONTEXT ONLY (oracle/trade_memory). Retrieval
#                                rides the adversarial-thesis path, so lessons
#                                only surface when ENABLE_ADVERSARIAL_THESIS is
#                                also ON. Never moves numbers / overrides a rule.
# ENABLE_EXECUTABLE_EV         : compute executable EV (theoretical EV net of
#                                spread/slippage/fill-probability). Veto-only,
#                                after the existing EV gate, before risk engine.
# ENABLE_FILL_MODEL            : calibrate the executable-EV fill model from the
#                                realized-fill ledger instead of the fixed
#                                conservative constants. OFF -> default constants
#                                (byte-identical). Calibration is fail-open +
#                                one-directional (more slippage, lower fill odds),
#                                so a thin ledger degrades to the same defaults.
# EXECUTABLE_EV_SHADOW_MODE    : when ON (default), a negative executable EV only
#                                logs a "would-reject"; when OFF it actually
#                                vetoes entry (still never overrides hard risk).
#                                Promotion is PAPER-FIRST: the veto only arms on
#                                a paper account (ALPACA_PAPER=true). On a live
#                                account it stays log-only regardless of this
#                                flag. Every evaluation is recorded to the
#                                calibration ledger for the Upgrade-G gate.
ENABLE_ORACLE_LAB=false
ENABLE_TEMPORAL_INTEGRITY=false
ENABLE_EVENT_DRIVEN_SIMULATION=false
ENABLE_ADVERSARIAL_THESIS=false
ADVERSARIAL_THESIS_GATING=false
ENABLE_SEMANTIC_TRADE_MEMORY=false
ENABLE_EXECUTABLE_EV=false
ENABLE_FILL_MODEL=false
EXECUTABLE_EV_SHADOW_MODE=true

# Oracle 3.0 tunables (only consulted when the matching feature is enabled).
# THESIS_MAX_NO_TRADE_BOOST : hard cap on how much the adversarial review may
#                             raise P(no-trade). It can only ADD doubt, never
#                             manufacture conviction or flip direction.
# ORACLE_TRADE_MEMORY_JSONL : append-only ledger path for trade reflections.
# ORACLE_LAB_RESULTS_DIR    : directory for lab experiment/sweep/walk-forward
#                             result JSON (offline analytics only).
# EXECUTION_CALIBRATION_JSONL : append-only ledger of executable-EV estimates
#                             (at entry) and realizations (at close), keyed by
#                             order_id. Feeds the Upgrade-G promotion gate.
THESIS_MAX_NO_TRADE_BOOST=0.10
ORACLE_TRADE_MEMORY_JSONL=oracle_trade_memory.jsonl
ORACLE_LAB_RESULTS_DIR=oracle/lab/results
EXECUTION_CALIBRATION_JSONL=execution_calibration.jsonl
